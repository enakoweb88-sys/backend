PORT=5000
NODE_ENV=production

# Supabase PostgreSQL (via PgBouncer for pooled connections)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=GENERATE_SECURE_SECRET_MIN_64_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=GENERATE_SECURE_SECRET_MIN_64_CHARS
JWT_REFRESH_TTL=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=https://enakoos.com,https://kyc.enakoos.com,https://outreach.cm,https://enakooutreach.cm,http://localhost:5173,http://localhost:3000

# Supabase Storage
SUPABASE_STORAGE_BUCKET=kyc-documents

# Resend Transactional Email Configuration (Verified domain: mail.enakoos.com)
# Obtain from your Resend Dashboard (Server-side ONLY - NEVER expose to frontend or git)
RESEND_API_KEY=

# Sender identities under mail.enakoos.com:
# security@mail.enakoos.com      - Security alerts & password notifications
# notifications@mail.enakoos.com - System & task notifications
# kyc@mail.enakoos.com           - KYC status updates & submissions
# noreply@mail.enakoos.com       - Automated no-reply dispatches
# support@mail.enakoos.com       - Customer support alerts
# Default Reply-To: support@enakoos.com

