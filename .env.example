PORT=5000
NODE_ENV=production

# Supabase PostgreSQL (via PgBouncer for pooled connections)
DATABASE_URL="postgresql://enako_runtime.PROJECT_REF:REPLACE_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Privileged migration connection: approved migration jobs only; never use for application queries.
DIRECT_URL="postgresql://MIGRATION_ROLE.PROJECT_REF:REPLACE_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
OS_APP_URL=https://enakoos.com
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=5m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=2h
JWT_ISSUER=https://api.enakoos.com
JWT_AUDIENCE=enako-company-os
# Independent Cash identities and permissions: no company role inheritance.
CASH_JWT_SECRET=
CASH_ACCESS_GRANTS={}
OS_PERMISSION_GRANTS={}
RATE_LIMIT_HASH_SECRET=

# Production must verify separate Cloudflare Access application audiences.
GATEWAY_ACCESS_MODE=required
CF_ACCESS_TEAM_DOMAIN=https://REPLACE_TEAM.cloudflareaccess.com
CF_ACCESS_OS_AUDIENCE=
CF_ACCESS_CASH_AUDIENCE=
# Exact trusted upstream proxy addresses/CIDRs; empty means trust no forwarding headers.
TRUSTED_PROXY_CIDRS=

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=https://enakoos.com,https://kyc.enakoos.com,https://outreach.cm,https://enakooutreach.cm,http://localhost:5173,http://localhost:3000

# Supabase Storage
SUPABASE_STORAGE_BUCKET=kyc-documents
# Scanner must be available on loopback; absence rejects document uploads.
FILE_SCANNER_HOST=127.0.0.1
FILE_SCANNER_PORT=3310
# Docker bundle only: enable after allocating sufficient ClamAV memory.
FILE_SCANNER_EMBEDDED=false

# Resend Transactional Email Configuration (Verified domain: mail.enakoos.com)
# Obtain from your Resend Dashboard (Server-side ONLY - NEVER expose to frontend or git)
RESEND_API_KEY=
# Cash sends mail through its own configuration, independent of OS contacts/templates.
CASH_RESEND_API_KEY=
CASH_MAIL_FROM=
CASH_MAIL_REPLY_TO=

# Sender identities under mail.enakoos.com:
# security@mail.enakoos.com      - Security alerts & password notifications
# notifications@mail.enakoos.com - System & task notifications
# kyc@mail.enakoos.com           - KYC status updates & submissions
# noreply@mail.enakoos.com       - Automated no-reply dispatches
# support@mail.enakoos.com       - Customer support alerts
# Default Reply-To: support@enakoos.com

