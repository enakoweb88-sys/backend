{
  "name": "enako-backend",
  "version": "1.0.0",
  "description": "NestJS backend for ENAKO OS",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:prod": "sh ./start.sh",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:security": "node scripts/run-security-tests.cjs",
    "test:integration": "node scripts/test-master-database.cjs && node scripts/test-master-http.cjs",
    "security:scan": "node scripts/scan-secrets.cjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:security && npm run test:integration && npm run build && npm run security:scan"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.20",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^7.2.0",
    "multer": "2.5.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.30.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cron": "^2.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "multer": "$multer",
    "body-parser": "^1.20.9",
    "lodash": "^4.18.1",
    "qs": "^6.17.1",
    "tmp": "^0.2.7",
    "webpack": "^5.112.2",
    "ajv@^8": "^8.20.0",
    "picomatch@^4": "^4.0.7",
    "glob@^10": "^10.5.0"
  }
}
